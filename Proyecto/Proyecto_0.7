import React, { useState, useEffect } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  FlatList,
  Pressable,
  SafeAreaView,
  Platform,
} from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';

const Stack = createNativeStackNavigator();

const STORAGE_KEY_MOVIMIENTOS = '@gestor_gastos_movimientos';
const STORAGE_KEY_USUARIO = '@gestor_gastos_usuario';
const STORAGE_KEY_PIN = '@gestor_gastos_pin';

const MOVIMIENTOS_BASE = [
  { id: '1', tipo: 'gasto', categoria: 'Alimentación', descripcion: 'Comida rápida', monto: 12500, fecha: 'Hoy, 2:30 PM' },
  { id: '2', tipo: 'ingreso', categoria: 'Salario', descripcion: 'Pago quincena', monto: 800000, fecha: 'Ayer' },
  { id: '3', tipo: 'gasto', categoria: 'Transporte', descripcion: 'Pasaje TransMilenio', monto: 3000, fecha: 'Ayer' },
];

function PantallaPin({ route, navigation }) {
  const { usuario, pinCorrecto } = route.params;
  const [pinIngresado, setPinIngresado] = useState('');
  const [errorPin, setErrorPin] = useState(false);

  const validarPin = () => {
    if (pinIngresado === pinCorrecto) {
      navigation.replace('Inicio', { usuario });
    } else {
      setErrorPin(true);
      setPinIngresado('');
    }
  };

  return (
    <SafeAreaView style={styles.containerCentrado}>
      <Text style={styles.bienvenidaTitulo}>Bloqueo de Seguridad</Text>
      <Text style={styles.bienvenidaSubtitulo}>
        Hola {usuario}, ingresa tu PIN de 4 dígitos para continuar
      </Text>

      <TextInput
        style={[styles.input, styles.inputPin, styles.targetAccesibleMinimo]}
        placeholder="••••"
        placeholderTextColor="#9CA3AF"
        keyboardType="numeric"
        secureTextEntry={true}
        maxLength={4}
        value={pinIngresado}
        onChangeText={(texto) => {
          setErrorPin(false);
          setPinIngresado(texto);
        }}
      />

      {errorPin && (
        <Text style={styles.textoError}>PIN incorrecto. Intenta de nuevo.</Text>
      )}

      <Pressable
        style={({ pressed }) => [
          styles.botonPrincipal,
          styles.targetAccesibleGrande,
          { opacity: pressed || pinIngresado.length !== 4 ? 0.7 : 1 },
        ]}
        disabled={pinIngresado.length !== 4}
        onPress={validarPin}
      >
        <Text style={styles.botonTexto}>Desbloquear</Text>
      </Pressable>
    </SafeAreaView>
  );
}

function PantallaBienvenida({ navigation }) {
  const [nombre, setNombre] = useState('');
  const [nuevoPin, setNuevoPin] = useState('');

  useEffect(() => {
    const verificarCredenciales = async () => {
      try {
        const usuarioGuardado = await AsyncStorage.getItem(STORAGE_KEY_USUARIO);
        const pinGuardado = await AsyncStorage.getItem(STORAGE_KEY_PIN);

        if (usuarioGuardado && pinGuardado) {
          navigation.replace('Pin', { usuario: usuarioGuardado, pinCorrecto: pinGuardado });
        } else if (usuarioGuardado && !pinGuardado) {
          navigation.replace('Inicio', { usuario: usuarioGuardado });
        }
      } catch (error) {
        console.error('Error al leer credenciales:', error);
      }
    };
    verificarCredenciales();
  }, [navigation]);

  const handleContinuar = async () => {
    const nombreLimpio = nombre.trim();
    if (!nombreLimpio || nuevoPin.length !== 4) return;

    try {
      await AsyncStorage.setItem(STORAGE_KEY_USUARIO, nombreLimpio);
      await AsyncStorage.setItem(STORAGE_KEY_PIN, nuevoPin);
      navigation.replace('Inicio', { usuario: nombreLimpio });
    } catch (error) {
      console.error('Error al guardar credenciales:', error);
      navigation.navigate('Inicio', { usuario: nombreLimpio });
    }
  };

  return (
    <SafeAreaView style={styles.containerCentrado}>
      <Text style={styles.bienvenidaTitulo}>Gestor de Gastos</Text>
      <Text style={styles.bienvenidaSubtitulo}>
        Ingresa tu nombre y crea tu PIN de 4 dígitos para proteger tus datos
      </Text>

      <TextInput
        style={[styles.input, styles.targetAccesibleMinimo]}
        placeholder="Tu nombre"
        placeholderTextColor="#9CA3AF"
        value={nombre}
        onChangeText={setNombre}
      />

      <TextInput
        style={[styles.input, styles.targetAccesibleMinimo]}
        placeholder="Crear PIN (4 dígitos numéricos)"
        placeholderTextColor="#9CA3AF"
        keyboardType="numeric"
        secureTextEntry={true}
        maxLength={4}
        value={nuevoPin}
        onChangeText={setNuevoPin}
      />

      <Pressable
        style={({ pressed }) => [
          styles.botonPrincipal,
          styles.targetAccesibleGrande,
          { opacity: pressed || !nombre.trim() || nuevoPin.length !== 4 ? 0.7 : 1 },
        ]}
        disabled={!nombre.trim() || nuevoPin.length !== 4}
        onPress={handleContinuar}
      >
        <Text style={styles.botonTexto}>Registrar y Comenzar</Text>
      </Pressable>
    </SafeAreaView>
  );
}

function PantallaInicio({ route, navigation }) {
  const { usuario } = route.params;

  const [busqueda, setBusqueda] = useState('');
  const [movimientos, setMovimientos] = useState([]);

  useEffect(() => {
    const cargarMovimientos = async () => {
      try {
        const datos = await AsyncStorage.getItem(STORAGE_KEY_MOVIMIENTOS);
        if (datos !== null) {
          setMovimientos(JSON.parse(datos));
        } else {
          setMovimientos(MOVIMIENTOS_BASE);
          await AsyncStorage.setItem(STORAGE_KEY_MOVIMIENTOS, JSON.stringify(MOVIMIENTOS_BASE));
        }
      } catch (error) {
        console.error('Error al cargar movimientos:', error);
        setMovimientos(MOVIMIENTOS_BASE);
      }
    };
    cargarMovimientos();
  }, []);

  const sincronizarMovimientos = async (nuevaLista) => {
    setMovimientos(nuevaLista);
    try {
      await AsyncStorage.setItem(STORAGE_KEY_MOVIMIENTOS, JSON.stringify(nuevaLista));
    } catch (error) {
      console.error('Error al guardar movimientos:', error);
    }
  };

  const saldo = movimientos.reduce(
    (acc, m) => acc + (m.tipo === 'ingreso' ? m.monto : -m.monto),
    0
  );

  const movimientosFiltrados = movimientos.filter((item) =>
    item.descripcion.toLowerCase().includes(busqueda.toLowerCase()) ||
    item.categoria.toLowerCase().includes(busqueda.toLowerCase())
  );

  const eliminarMovimiento = (id) => {
    const actualizados = movimientos.filter((m) => m.id !== id);
    sincronizarMovimientos(actualizados);
  };

  const agregarNuevoMovimiento = (nuevo) => {
    const actualizados = [nuevo, ...movimientos];
    sincronizarMovimientos(actualizados);
  };

  const bloquearApp = async () => {
    const pinGuardado = await AsyncStorage.getItem(STORAGE_KEY_PIN);
    navigation.replace('Pin', { usuario, pinCorrecto: pinGuardado });
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.paddingContenido}>
        <View style={styles.filaUsuarioHeader}>
          <View>
            <Text style={styles.saludoChico}>Bienvenido,</Text>
            <Text style={styles.saludoNombre}>{usuario}</Text>
          </View>
          <Pressable
            style={[styles.botonBloquear, styles.targetAccesibleMinimo]}
            onPress={bloquearApp}
          >
            <Text style={styles.botonBloquearTexto}>🔒 Bloquear</Text>
          </Pressable>
        </View>

        <View style={styles.tarjetaSaldo}>
          <Text style={styles.etiquetaSaldo}>SALDO TOTAL DISPONIBLE</Text>
          <Text
            style={[
              styles.montoSaldo,
              { color: saldo >= 0 ? '#4ADE80' : '#F87171' },
            ]}
          >
            ${saldo.toLocaleString('es-CO')}
          </Text>
          <Text style={styles.detalleTransacciones}>
            {movimientos.length} transacciones registradas
          </Text>
        </View>

        <TextInput
          style={[styles.inputBusqueda, styles.targetAccesibleMinimo]}
          placeholder="🔍 Buscar por nombre o categoría..."
          placeholderTextColor="#9CA3AF"
          value={busqueda}
          onChangeText={setBusqueda}
        />

        <View style={styles.headerLista}>
          <Text style={styles.subtituloLista}>Movimientos recientes</Text>

          <Pressable
            style={({ pressed }) => [
              styles.botonAgregarTactil,
              styles.targetAccesibleMinimo,
              { opacity: pressed ? 0.6 : 1 },
            ]}
            onPress={() =>
              navigation.navigate('NuevoMovimiento', {
                onGuardar: agregarNuevoMovimiento,
              })
            }
          >
            <Text style={styles.linkAgregar}>+ Agregar</Text>
          </Pressable>
        </View>
      </View>

      <FlatList
        style={styles.paddingContenido}
        data={movimientosFiltrados}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <Pressable
            style={({ pressed }) => [
              styles.tarjetaItem,
              {
                borderLeftColor: item.tipo === 'gasto' ? '#F87171' : '#4ADE80',
                opacity: pressed ? 0.8 : 1,
              },
            ]}
            onPress={() =>
              navigation.navigate('Detalle', {
                movimiento: item,
                onEliminar: eliminarMovimiento,
              })
            }
          >
            <View style={{ flex: 1 }}>
              <Text style={styles.itemDescripcion}>{item.descripcion}</Text>
              <Text style={styles.itemCategoria}>{item.categoria}</Text>
            </View>
            <Text
              style={[
                styles.itemMonto,
                { color: item.tipo === 'gasto' ? '#F87171' : '#4ADE80' },
              ]}
            >
              {item.tipo === 'gasto' ? '-' : '+'}${item.monto.toLocaleString('es-CO')}
            </Text>
          </Pressable>
        )}
        ListEmptyComponent={
          <Text style={styles.textoVacio}>No se encontraron movimientos</Text>
        }
      />
    </SafeAreaView>
  );
}

function PantallaDetalle({ route, navigation }) {
  const { movimiento, onEliminar } = route.params;

  const handleEliminar = () => {
    onEliminar(movimiento.id);
    navigation.goBack();
  };

  return (
    <SafeAreaView style={styles.containerCentrado}>
      <View style={styles.cardDetalle}>
        <Text style={styles.detalleTipo}>
          {movimiento.tipo.toUpperCase()}
        </Text>
        <Text
          style={[
            styles.detalleMonto,
            { color: movimiento.tipo === 'gasto' ? '#F87171' : '#4ADE80' },
          ]}
        >
          {movimiento.tipo === 'gasto' ? '-' : '+'}${movimiento.monto.toLocaleString('es-CO')}
        </Text>

        <View style={styles.divisor} />

        <View style={styles.filaDetalle}>
          <Text style={styles.labelDetalle}>Concepto:</Text>
          <Text style={styles.valorDetalle}>{movimiento.descripcion}</Text>
        </View>

        <View style={styles.filaDetalle}>
          <Text style={styles.labelDetalle}>Categoría:</Text>
          <Text style={styles.valorDetalle}>{movimiento.categoria}</Text>
        </View>

        <View style={styles.filaDetalle}>
          <Text style={styles.labelDetalle}>Fecha / Registro:</Text>
          <Text style={styles.valorDetalle}>{movimiento.fecha}</Text>
        </View>

        <Pressable
          style={({ pressed }) => [
            styles.botonEliminar,
            styles.targetAccesibleGrande,
            { opacity: pressed ? 0.7 : 1 },
          ]}
          onPress={handleEliminar}
        >
          <Text style={styles.botonEliminarTexto}>Eliminar movimiento</Text>
        </Pressable>
      </View>
    </SafeAreaView>
  );
}

function PantallaNuevoMovimiento({ route, navigation }) {
  const { onGuardar } = route.params;
  const [tipo, setTipo] = useState('gasto');
  const [descripcion, setDescripcion] = useState('');
  const [categoria, setCategoria] = useState('');
  const [monto, setMonto] = useState('');

  const guardar = () => {
    const montoNum = parseFloat(monto);
    if (!monto || isNaN(montoNum) || !descripcion.trim()) return;

    onGuardar({
      id: Date.now().toString(),
      tipo,
      descripcion: descripcion.trim(),
      categoria: categoria.trim() || 'Varios',
      monto: montoNum,
      fecha: 'Hoy',
    });

    navigation.goBack();
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.paddingContenido}>
        <View style={styles.selectorTipo}>
          <Pressable
            style={[
              styles.tipoBtn,
              styles.targetAccesibleGrande,
              tipo === 'gasto' && styles.tipoActivoGasto,
            ]}
            onPress={() => setTipo('gasto')}
          >
            <Text style={styles.tipoTexto}>Gasto</Text>
          </Pressable>
          <Pressable
            style={[
              styles.tipoBtn,
              styles.targetAccesibleGrande,
              tipo === 'ingreso' && styles.tipoActivoIngreso,
            ]}
            onPress={() => setTipo('ingreso')}
          >
            <Text style={styles.tipoTexto}>Ingreso</Text>
          </Pressable>
        </View>

        <TextInput
          style={[styles.input, styles.targetAccesibleMinimo]}
          placeholder="Descripción (ej. Supermercado)"
          placeholderTextColor="#9CA3AF"
          value={descripcion}
          onChangeText={setDescripcion}
        />

        <TextInput
          style={[styles.input, styles.targetAccesibleMinimo]}
          placeholder="Categoría (ej. Comida, Servicios)"
          placeholderTextColor="#9CA3AF"
          value={categoria}
          onChangeText={setCategoria}
        />

        <TextInput
          style={[styles.input, styles.targetAccesibleMinimo]}
          placeholder="Monto"
          placeholderTextColor="#9CA3AF"
          keyboardType="numeric"
          value={monto}
          onChangeText={setMonto}
        />

        <Pressable
          style={({ pressed }) => [
            styles.botonPrincipal,
            styles.targetAccesibleGrande,
            { opacity: pressed ? 0.7 : 1 },
          ]}
          onPress={guardar}
        >
          <Text style={styles.botonTexto}>Guardar Transacción</Text>
        </Pressable>
      </View>
    </SafeAreaView>
  );
}

export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator
        screenOptions={{
          headerStyle: { backgroundColor: '#12111A' },
          headerTintColor: '#FFFFFF',
          headerTitleStyle: { fontWeight: 'bold' },
          contentStyle: { backgroundColor: '#0B0A10' },
        }}
      >
        <Stack.Screen name="Bienvenida" component={PantallaBienvenida} options={{ headerShown: false }} />
        <Stack.Screen name="Pin" component={PantallaPin} options={{ headerShown: false }} />
        <Stack.Screen name="Inicio" component={PantallaInicio} options={{ headerBackVisible: false, title: 'Panel de Control' }} />
        <Stack.Screen name="Detalle" component={PantallaDetalle} options={{ title: 'Detalle de Movimiento' }} />
        <Stack.Screen name="NuevoMovimiento" component={PantallaNuevoMovimiento} options={{ title: 'Nuevo Registro' }} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}

