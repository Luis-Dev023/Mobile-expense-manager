// ---------------------------------------------------------
// Helpers: geometría para la gráfica de torta
// ---------------------------------------------------------
function polarAPunto(cx, cy, radio, angulo) {
  const rad = ((angulo - 90) * Math.PI) / 180;
  return {
    x: cx + radio * Math.cos(rad),
    y: cy + radio * Math.sin(rad),
  };
}

function crearSector(cx, cy, radio, anguloInicio, anguloFin) {
  const inicio = polarAPunto(cx, cy, radio, anguloFin);
  const fin = polarAPunto(cx, cy, radio, anguloInicio);
  const arcoGrande = anguloFin - anguloInicio <= 180 ? '0' : '1';
  return [
    `M ${cx} ${cy}`,
    `L ${inicio.x} ${inicio.y}`,
    `A ${radio} ${radio} 0 ${arcoGrande} 0 ${fin.x} ${fin.y}`,
    'Z',
  ].join(' ');
}

// ---------------------------------------------------------
// Componente: Gráfica de torta (Gastos vs Ingresos)
// ---------------------------------------------------------
function GraficaSaldo({ movimientos }) {
  const size = 180;
  const radio = 75;
  const cx = size / 2;
  const cy = size / 2;

  const totalGastos = movimientos
    .filter((m) => m.tipo === 'gasto')
    .reduce((acc, m) => acc + m.monto, 0);
  const totalIngresos = movimientos
    .filter((m) => m.tipo === 'ingreso')
    .reduce((acc, m) => acc + m.monto, 0);
  const total = totalGastos + totalIngresos;

  if (total === 0) {
    return (
      <View style={[styles.chartCard, { height: 160, justifyContent: 'center', alignItems: 'center' }]}>
        <Text style={{ color: '#888' }}>Agrega movimientos para ver tu gráfica</Text>
      </View>
    );
  }

  const anguloGastos = (totalGastos / total) * 360;

  return (
    <View style={[styles.chartCard, { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-around' }]}>
      <Svg width={size} height={size}>
        {totalGastos > 0 && (
          <Path d={crearSector(cx, cy, radio, 0, anguloGastos)} fill="#E24A4A" />
        )}
        {totalIngresos > 0 && (
          <Path d={crearSector(cx, cy, radio, anguloGastos, 360)} fill="#5FE38B" />
        )}
        <Circle cx={cx} cy={cy} r={radio * 0.55} fill="#171326" />
      </Svg>

      <View>
        <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 10 }}>
          <View style={[styles.leyendaPunto, { backgroundColor: '#E24A4A' }]} />
          <View>
            <Text style={styles.leyendaTexto}>Gastos</Text>
            <Text style={styles.leyendaMonto}>${totalGastos.toLocaleString('es-CO')}</Text>
          </View>
        </View>
        <View style={{ flexDirection: 'row', alignItems: 'center' }}>
          <View style={[styles.leyendaPunto, { backgroundColor: '#5FE38B' }]} />
          <View>
            <Text style={styles.leyendaTexto}>Ingresos</Text>
            <Text style={styles.leyendaMonto}>${totalIngresos.toLocaleString('es-CO')}</Text>
          </View>
        </View>
      </View>
    </View>
  );
}

// ---------------------------------------------------------
// Modal: Editar o Eliminar movimiento
// ---------------------------------------------------------
function ModalEditarMovimiento({ movimiento, visible, onCerrar, onGuardar, onEliminar }) {
  const [monto, setMonto] = useState('');
  const [descripcion, setDescripcion] = useState('');

  // Sincroniza los campos cada vez que cambia el movimiento seleccionado
  React.useEffect(() => {
    if (movimiento) {
      setMonto(String(movimiento.monto));
      setDescripcion(movimiento.descripcion);
    }
  }, [movimiento]);

  if (!movimiento) return null;

  const handleGuardar = () => {
    const nuevoMonto = parseFloat(monto);
    if (!monto || isNaN(nuevoMonto) || nuevoMonto <= 0) return;
    onGuardar(movimiento.id, nuevoMonto, descripcion.trim() || movimiento.descripcion);
  };

  return (
    <Modal visible={visible} transparent animationType="fade" onRequestClose={onCerrar}>
      <View style={styles.modalFondo}>
        <View style={styles.modalCaja}>
          <View style={styles.modalHeader}>
            <Text style={styles.modalTitulo}>
              {movimiento.tipo === 'gasto' ? 'Editar gasto' : 'Editar ingreso'}
            </Text>
            <TouchableOpacity onPress={onCerrar}>
              <Text style={styles.modalCerrarX}>✕</Text>
            </TouchableOpacity>
          </View>

          <Text style={styles.modalEtiqueta}>Descripción</Text>
          <TextInput
            style={styles.input}
            placeholderTextColor="#999"
            value={descripcion}
            onChangeText={setDescripcion}
          />

          <Text style={styles.modalEtiqueta}>Monto</Text>
          <TextInput
            style={styles.input}
            keyboardType="numeric"
            placeholderTextColor="#999"
            value={monto}
            onChangeText={setMonto}
          />

          <TouchableOpacity style={styles.botonGuardar} onPress={handleGuardar}>
            <Text style={styles.botonGuardarTexto}>Guardar cambios</Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.botonEliminar}
            onPress={() => onEliminar(movimiento.id)}
          >
            <Text style={styles.botonEliminarTexto}>Eliminar movimiento</Text>
          </TouchableOpacity>

          <TouchableOpacity style={styles.botonCancelarModal} onPress={onCerrar}>
            <Text style={styles.botonCancelarModalTexto}>Cancelar</Text>
          </TouchableOpacity>
        </View>
      </View>
    </Modal>
  );
}

// ---------------------------------------------------------
// Pantalla: Agregar Gasto o Ingreso
// ---------------------------------------------------------
function PantallaAgregar({ onGuardar, onCancelar }) {
  const [tipo, setTipo] = useState('gasto');
  const [descripcion, setDescripcion] = useState('');
  const [monto, setMonto] = useState('');

  const handleGuardar = () => {
    if (!monto || isNaN(parseFloat(monto))) return;
    onGuardar({
      id: Date.now().toString(),
      tipo,
      descripcion: descripcion || (tipo === 'gasto' ? 'Gasto' : 'Ingreso'),
      monto: parseFloat(monto),
    });
  };

  return (
    <View style={styles.container}>
      <TouchableOpacity onPress={onCancelar} style={styles.flecha}>
        <Text style={{ color: '#FFFFFF', fontSize: 18 }}>{'←'}</Text>
      </TouchableOpacity>

      <Text style={styles.titulo}>Nuevo movimiento</Text>

      <View style={styles.selectorTipo}>
        <TouchableOpacity
          style={[styles.tipoBtn, tipo === 'gasto' && styles.tipoActivoGasto]}
          onPress={() => setTipo('gasto')}
        >
          <Text style={styles.tipoTexto}>Gasto</Text>
        </TouchableOpacity>
        <TouchableOpacity
          style={[styles.tipoBtn, tipo === 'ingreso' && styles.tipoActivoIngreso]}
          onPress={() => setTipo('ingreso')}
        >
          <Text style={styles.tipoTexto}>Ingreso</Text>
        </TouchableOpacity>
      </View>

      <TextInput
        style={styles.input}
        placeholder="Descripción (ej: Comida rápida)"
        placeholderTextColor="#999"
        value={descripcion}
        onChangeText={setDescripcion}
      />

      <TextInput
        style={styles.input}
        placeholder="Monto"
        placeholderTextColor="#999"
        keyboardType="numeric"
        value={monto}
        onChangeText={setMonto}
      />

      <TouchableOpacity style={styles.botonGuardar} onPress={handleGuardar}>
        <Text style={styles.botonGuardarTexto}>Guardar</Text>
      </TouchableOpacity>
    </View>
  );
}

// ---------------------------------------------------------
// Pantalla: Inicio
// ---------------------------------------------------------
function PantallaInicio({ nombre, movimientos, saldo, onIrAgregar, onEditarMonto, onEliminar }) {
  const [movimientoSeleccionado, setMovimientoSeleccionado] = useState(null);

  const abrirModal = (item) => setMovimientoSeleccionado(item);
  const cerrarModal = () => setMovimientoSeleccionado(null);

  const guardarCambios = (id, nuevoMonto, nuevaDescripcion) => {
    onEditarMonto(id, nuevoMonto, nuevaDescripcion);
    cerrarModal();
  };

  const eliminarYcerrar = (id) => {
    onEliminar(id);
    cerrarModal();
  };

  return (
    <View style={styles.container}>
      <View style={{ width: '100%', paddingHorizontal: 25 }}>
        <Text style={styles.saludoChico}>Hola</Text>
        <Text style={styles.saludoNombre}>{nombre}</Text>

        <TouchableOpacity style={styles.tarjetaBolsillo} onPress={onIrAgregar}>
          <View style={styles.bolsilloHeader}>
            <Text style={styles.bolsilloTitulo}>BOLSILLO</Text>
            <View style={styles.puntoAzul} />
          </View>
          <Text
            style={[
              styles.bolsilloSaldo,
              { color: saldo >= 0 ? '#5FE38B' : '#E24A4A' },
            ]}
          >
            {saldo >= 0 ? '▲' : '▼'} ${Math.abs(saldo).toLocaleString('es-CO')}
          </Text>
          <Text style={styles.bolsilloTransacciones}>
            {movimientos.length} transacciones
          </Text>
        </TouchableOpacity>

        <GraficaSaldo movimientos={movimientos} />

        <Text style={styles.subtituloLista}>Movimientos recientes</Text>
      </View>

      <FlatList
        style={{ width: '100%', paddingHorizontal: 25 }}
        data={movimientos}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <TouchableOpacity
            style={[
              styles.filaMovimiento,
              { borderLeftColor: item.tipo === 'gasto' ? '#E24A4A' : '#5FE38B' },
            ]}
            onPress={() => abrirModal(item)}
            activeOpacity={0.7}
          >
            <Text style={styles.filaDescripcion}>{item.descripcion}</Text>
            <Text
              style={[
                styles.filaMonto,
                { color: item.tipo === 'gasto' ? '#E24A4A' : '#5FE38B' },
              ]}
            >
              {item.tipo === 'gasto' ? '-' : '+'}${item.monto.toLocaleString('es-CO')}
            </Text>
          </TouchableOpacity>
        )}
        ListEmptyComponent={
          <Text style={{ color: '#888', textAlign: 'center', marginTop: 10 }}>
            Aún no tienes movimientos
          </Text>
        }
      />

      <TouchableOpacity style={styles.botonFlotante} onPress={onIrAgregar}>
        <Text style={styles.botonFlotanteTexto}>+</Text>
      </TouchableOpacity>

      <View style={styles.navInferior}>
        <View style={styles.navItem}>
          <Text style={styles.navIcono}>🏠</Text>
          <Text style={[styles.navTexto, { color: '#7C9CF2' }]}>Inicio</Text>
        </View>
        <View style={styles.navItem}>
          <Text style={styles.navIcono}>📄</Text>
          <Text style={styles.navTexto}>Transacciones</Text>
        </View>
        <View style={styles.navItem}>
          <Text style={styles.navIcono}>📊</Text>
          <Text style={styles.navTexto}>Presupuestos</Text>
        </View>
        <View style={styles.navItem}>
          <Text style={styles.navIcono}>⋯</Text>
          <Text style={styles.navTexto}>Más</Text>
        </View>
      </View>

      <ModalEditarMovimiento
        movimiento={movimientoSeleccionado}
        visible={!!movimientoSeleccionado}
        onCerrar={cerrarModal}
        onGuardar={guardarCambios}
        onEliminar={eliminarYcerrar}
      />
    </View>
  );
}

// ---------------------------------------------------------
// App principal
// ---------------------------------------------------------
export default function App() {
  const [nombre, setNombre] = useState(null);
  const [pantalla, setPantalla] = useState('bienvenida'); // 'bienvenida' | 'inicio' | 'agregar'
  const [movimientos, setMovimientos] = useState([
    { id: '1', tipo: 'gasto', descripcion: 'Comida rápida', monto: 12500 },
    { id: '2', tipo: 'ingreso', descripcion: 'Pago quincena', monto: 800000 },
    { id: '3', tipo: 'gasto', descripcion: 'Transporte', monto: 3000 },
  ]);

  const saldo = movimientos.reduce(
    (acc, m) => acc + (m.tipo === 'ingreso' ? m.monto : -m.monto),
    0
  );

  const agregarMovimiento = (nuevo) => {
    setMovimientos((prev) => [nuevo, ...prev]);
    setPantalla('inicio');
  };

  const editarMovimiento = (id, nuevoMonto, nuevaDescripcion) => {
    setMovimientos((prev) =>
      prev.map((m) =>
        m.id === id ? { ...m, monto: nuevoMonto, descripcion: nuevaDescripcion } : m
      )
    );
  };

  const eliminarMovimiento = (id) => {
    setMovimientos((prev) => prev.filter((m) => m.id !== id));
  };

  if (pantalla === 'bienvenida') {
    return (
      <PantallaBienvenida
        onContinuar={(n) => {
          setNombre(n);
          setPantalla('inicio');
        }}
      />
    );
  }

  if (pantalla === 'agregar') {
    return (
      <PantallaAgregar
        onGuardar={agregarMovimiento}
        onCancelar={() => setPantalla('inicio')}
      />
    );
  }

  return (
    <PantallaInicio
      nombre={nombre}
      movimientos={movimientos}
      saldo={saldo}
      onIrAgregar={() => setPantalla('agregar')}
      onEditarMonto={editarMovimiento}
      onEliminar={eliminarMovimiento}
    />
  );
}

